# ---------------------------------------------------------------------------
# Serendiva API — environment variables (copy to .env and adjust)
# PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL of this API (used for uploaded file URLs and the docs)
API_PUBLIC_URL=http://localhost:4000
# Client IP detection behind a reverse proxy / load balancer (used by rate limiting and logs):
#   false = not behind a proxy (local development)
#   1     = one proxy in front of the API that appends to X-Forwarded-For (Render, Railway, Fly, Nginx)
#   10.0.0.0/8,127.0.0.1 = trust only these proxy addresses
# Avoid "true": it trusts every X-Forwarded-For entry, so clients could fake their IP.
TRUST_PROXY=false

# PostgreSQL (docker-compose starts one on port 5432)
DATABASE_URL=postgresql://serendiva:serendiva@localhost:5432/serendiva
# Database used by `npm test` — it is WIPED on every run. The name must contain "test".
# (docker-compose creates it; read by the tests only, never by the API itself)
TEST_DATABASE_URL=postgresql://serendiva:serendiva@localhost:5432/serendiva_test

# Comma-separated list of browser origins allowed to call the API (FRONTEND_URL is always allowed)
CORS_ORIGINS=http://localhost:3000
# The Next.js website (used for revalidation webhooks and links in emails)
FRONTEND_URL=http://localhost:3000
# Shared secret with the Next.js app's /api/revalidate route (min 16 chars)
REVALIDATE_SECRET=change-me-revalidate-secret-123

# Auth — generate long random strings (cryptographically secure), e.g. in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Leave empty for host-only cookies. Use ".yourdomain.com" when web and API share a parent domain.
COOKIE_DOMAIN=
# auto = Secure in production only
COOKIE_SECURE=auto
# lax (same-site / proxied setups) or none (true cross-site; requires HTTPS)
COOKIE_SAMESITE=lax

# First admin account (created by `npm run db:seed`)
ADMIN_SEED_EMAIL=admin@serendiva.lk
ADMIN_SEED_PASSWORD=ChangeMe-Serendiva-2026
ADMIN_SEED_NAME=Dinesh Jayasuriya

# Email: "console" writes emails to tmp/emails (development); "resend" sends real mail
EMAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Serendiva <hello@serendiva.lk>
GUIDE_NOTIFY_EMAIL=guide@serendiva.lk

# File storage: "local" (uploads/ folder served at /uploads) or "s3" (AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Max form submissions per IP per minute (inquiry, proposal, newsletter, review)
FORM_RATE_LIMIT=5
# Optional Cloudflare Turnstile secret (leave empty to disable)
TURNSTILE_SECRET=

EMAIL_RETRY_INTERVAL_MINUTES=10
EMAIL_RETRY_DISABLED=false
REVALIDATE_DISABLED=false
